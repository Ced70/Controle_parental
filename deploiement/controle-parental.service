[Unit]
Description=Contrôle Parental Intelligent — backend Rust
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cedric
# Le binaire lit controle_parental.db et youtube_api.key dans ce dossier :
WorkingDirectory=/home/cedric/Rust/Controle_parental
ExecStart=/home/cedric/Rust/Controle_parental/target/release/controle_parental
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
